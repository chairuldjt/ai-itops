# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_gateway

# App port (default: 9003, change if needed)
PORT=9003

# App
NEXT_PUBLIC_APP_URL=http://localhost:9003
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Better Auth base URL (must match NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:9003

# 9router upstream (OpenAI-compatible)
UPSTREAM_BASE_URL=http://localhost:8080/v1
UPSTREAM_API_KEY=
# Optional: timeout in ms for upstream requests
# UPSTREAM_TIMEOUT_MS=120000

# Seed admin (used by `pnpm db:seed` or `pnpm db:init`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-123
SEED_ADMIN_NAME=Administrator

# Resend (transactional email — OTP & password reset)
# Get a key at https://resend.com/api-keys. Leave empty to log emails to console in dev.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend (or onboarding@resend.dev in dev).
EMAIL_FROM=AI Gateway <noreply@yourdomain.com>
